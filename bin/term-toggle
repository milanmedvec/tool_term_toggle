#!/usr/bin/env bash
set -euo pipefail

need() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '%s: missing required command: %s\n' "${0##*/}" "$1" >&2
        exit 127
    }
}

need xdotool
need i3-msg
need alacritty
need tmux


class="dropdown-term"

if xdotool search --class "$class" >/dev/null 2>&1; then
    i3-msg "[class=\"$class\"] scratchpad show" >/dev/null
else
    alacritty --class "$class" -e bash -c '
        icon="${XDG_DATA_HOME:-$HOME/.local/share}/pixmaps/dropdown-term.png"
        if [[ -n "${WINDOWID:-}" ]] && [[ -f "$icon" ]] && command -v xseticon >/dev/null 2>&1; then
            xseticon -id "$WINDOWID" "$icon" 2>/dev/null || true
        fi
        exec tmux new-session -A -s dropdown
    ' &
fi
