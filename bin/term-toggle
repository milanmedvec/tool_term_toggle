#!/usr/bin/env bash
set -euo pipefail

class="dropdown-term"

if xdotool search --class "$class" >/dev/null 2>&1; then
    i3-msg "[class=\"$class\"] scratchpad show" >/dev/null
else
    alacritty --class "$class" -e bash -c '
        xseticon -id "$WINDOWID" "$HOME/.local/share/pixmaps/dropdown-term.png"
        exec "$SHELL"
    ' &
fi
